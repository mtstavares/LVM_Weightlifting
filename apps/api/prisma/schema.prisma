generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TRAINER @map("COACH")
  ATHLETE
}

enum AccountCodeType {
  EMAIL_VERIFICATION
}

enum AuthAuditEvent {
  TRAINER_REGISTERED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_FAILED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  PASSWORD_RECOVERY_REQUESTED
  TEMPORARY_PASSWORD_SENT
  PASSWORD_CHANGED
  ATHLETE_CREATED
  ATHLETE_INVITATION_RESENT
  ATHLETE_FIRST_LOGIN
  ATHLETE_TEMPORARY_PASSWORD_CHANGED
  ATHLETE_DEACTIVATED
  ATHLETE_REACTIVATED
  ATHLETE_UPDATED
  TRAINING_CREATED
  TRAINING_UPDATED
  TRAINING_DELETED
  TRAINING_STARTED
  TRAINING_COMPLETED
  TRAINING_MESSAGE_SENT
  TRAINING_MANUAL_PRESCRIPTION_CREATED
  TRAINING_PERCENTAGE_PRESCRIPTION_CREATED
  TRAINING_PERCENTAGE_CALCULATED
  TRAINING_PERCENTAGE_WITHOUT_PR
  TRAINING_CORE_PRESCRIPTION_CREATED
  TRAINING_ACCESSORY_PRESCRIPTION_CREATED
  PERSONAL_RECORD_CANDIDATE_IDENTIFIED
  PERSONAL_RECORD_UPDATE_CONFIRMED
  PERSONAL_RECORD_UPDATE_DECLINED
  TRAINING_ARCHIVED
  FEEDBACK_CREATED
  FEEDBACK_UPDATED
  COACH_COMMENT_ADDED
  ATHLETE_PROFILE_COMPLETED
  ATHLETE_PROFILE_UPDATED
  ATHLETE_PHOTO_UPDATED
  PERSONAL_RECORD_UPSERTED
  TRAINER_PROTECTED_EDIT_DENIED
  TRAINER_PROFILE_UPDATED
  TRAINER_PHOTO_UPDATED
  ACCESS_DENIED
  EXERCISE_CREATED
  EXERCISE_UPDATED
  EXERCISE_DUPLICATED
  EXERCISE_DEACTIVATED
  EXERCISE_GLOBAL_EDIT_DENIED
  EXERCISE_ACCESS_DENIED
  FEED_POST_CREATED
  FEED_POST_DELETED_BY_AUTHOR
  FEED_POST_DELETED_BY_TRAINER
  FEED_POST_DELETE_DENIED
  FEED_ACCESS_DENIED
  FEED_UPLOAD_INVALID_TYPE
  FEED_UPLOAD_VIDEO_TOO_LONG
  FEED_COMMENT_CREATED
  FEED_COMMENT_DELETED_BY_AUTHOR
  FEED_COMMENT_DELETED_BY_TRAINER
  FEED_COMMENT_DELETE_DENIED
  FEED_COMMENT_CREATE_DENIED
  FEED_LIKE_CREATED
  FEED_LIKE_REMOVED
  FEED_LIKE_DENIED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum AthleteProfileStatus {
  PROFILE_INCOMPLETE
  PROFILE_COMPLETE
}

enum AthleteSex {
  FEMALE
  MALE
}

enum CompetitiveLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  NATIONAL
  INTERNATIONAL
}

enum PersonalRecordMovement {
  SNATCH
  CLEAN_JERK
  BACK_SQUAT
  FRONT_SQUAT
  DEADLIFT
}

enum TrainingWeekStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExerciseCategory {
  SNATCH
  CLEAN_AND_JERK
  CLEAN
  JERK
  SQUAT
  PULL
  DEADLIFT
  MOBILITY
  GENERAL_WARMUP
  ACCESSORY
}

enum ExercisePrescriptionType {
  LOAD
  TIME
  TEXT
}

enum FeedPostMediaType {
  IMAGE
  VIDEO
}

enum TrainingBlockType {
  STANDARD
  COMPLEX
  STRENGTH
  ACCESSORY
}

enum TrainingSectionType {
  WARMUP
  TECHNIQUE_BALLISTIC
  STRENGTH
  BODYBUILDING
}

enum TrainingRevisionAction {
  CREATED
  UPDATED
  DELETED
}

enum TargetPrExercise {
  SNATCH
  CLEAN
  JERK
  CLEAN_JERK
  BACK_SQUAT
  FRONT_SQUAT
  DEADLIFT
}

model User {
  id                         String    @id @default(uuid())
  fullName                   String    @default("") @map("full_name")
  email                      String    @unique
  passwordHash               String    @map("password_hash")
  role                       UserRole
  isActive                   Boolean   @default(false) @map("is_active")
  emailVerifiedAt            DateTime? @map("email_verified_at")
  mustChangePassword         Boolean   @default(false) @map("must_change_password")
  temporaryPasswordExpiresAt DateTime? @map("temporary_password_expires_at")
  temporaryPasswordUsedAt    DateTime? @map("temporary_password_used_at")
  failedLoginAttempts        Int       @default(0) @map("failed_login_attempts")
  lockedUntil                DateTime? @map("locked_until")
  firstLoginAt               DateTime? @map("first_login_at")
  lastLoginAt                DateTime? @map("last_login_at")
  lastPasswordChangeAt       DateTime? @map("last_password_change_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  coachSettings  CoachSettings?
  coachAthletes  Athlete[]      @relation("CoachAthletes")
  athleteProfile Athlete?       @relation("AthleteUser")
  coachComments  CoachComment[]
  trainingMessages TrainingMessage[]
  customExercises Exercise[] @relation("TrainerCustomExercises")
  authoredFeedPosts FeedPost[] @relation("FeedPostAuthor")
  trainerFeedPosts FeedPost[] @relation("FeedPostTrainer")
  authoredFeedComments FeedComment[] @relation("FeedCommentAuthor")
  feedLikes FeedLike[] @relation("FeedLikeUser")
  refreshTokens  RefreshToken[]
  accountCodes   AccountCode[]
  auditLogs      AuthAuditLog[] @relation("LegacyAuditUser")
  auditActions   AuthAuditLog[] @relation("AuditActor")
  auditEffects   AuthAuditLog[] @relation("AuditAffected")
  trainingRevisions TrainingRevision[] @relation("TrainingRevisionActor")

  @@map("users")
}

model AccountCode {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  type        AccountCodeType
  codeHash    String          @map("code_hash")
  expiresAt   DateTime        @map("expires_at")
  usedAt      DateTime?       @map("used_at")
  attempts    Int             @default(0)
  maxAttempts Int             @default(5) @map("max_attempts")
  createdAt   DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, usedAt])
  @@map("account_codes")
}

model AuthAuditLog {
  id             String         @id @default(uuid())
  userId         String?        @map("user_id")
  actorUserId    String?        @map("actor_user_id")
  affectedUserId String?        @map("affected_user_id")
  email          String?
  event          AuthAuditEvent
  description    String         @default("")
  result         AuditResult    @default(SUCCESS)
  ipAddress      String?        @map("ip_address")
  userAgent      String?        @map("user_agent")
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")

  user         User? @relation("LegacyAuditUser", fields: [userId], references: [id], onDelete: SetNull)
  actorUser    User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  affectedUser User? @relation("AuditAffected", fields: [affectedUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([affectedUserId, createdAt])
  @@index([event, result, createdAt])
  @@index([email, createdAt])
  @@map("auth_audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model CoachSettings {
  id                String    @id @default(uuid())
  coachId           String    @unique @map("coach_id")
  profilePhoto      String?   @map("profile_photo")
  birthDate         DateTime? @map("birth_date") @db.Date
  gym               String?
  bio               String?
  roundingIncrement Decimal   @default(2.5) @map("rounding_increment") @db.Decimal(4, 1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  coach User @relation(fields: [coachId], references: [id])

  @@map("coach_settings")
}

model Athlete {
  id                 String               @id @default(uuid())
  userId             String               @unique @map("user_id")
  coachId            String               @map("coach_id")
  firstName          String               @map("first_name")
  lastName           String               @map("last_name")
  profilePhoto       String?              @map("profile_photo")
  birthDate          DateTime?            @map("birth_date") @db.Date
  sex                AthleteSex?
  weightCategory     String?              @map("weight_category")
  competitiveLevel   CompetitiveLevel?    @map("competitive_level")
  gym                String?
  profileStatus      AthleteProfileStatus @default(PROFILE_INCOMPLETE) @map("profile_status")
  profileCompletedAt DateTime?            @map("profile_completed_at")
  isActive           Boolean              @default(true) @map("is_active")
  deactivatedAt      DateTime?            @map("deactivated_at")
  deactivationReason String?              @map("deactivation_reason")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  user               User                @relation("AthleteUser", fields: [userId], references: [id])
  coach              User                @relation("CoachAthletes", fields: [coachId], references: [id])
  trainingWeeks      TrainingWeek[]
  workoutCompletions WorkoutCompletion[]
  feedbacks          Feedback[]
  uploadedVideos     UploadedVideo[]
  personalRecords    PersonalRecord[]
  personalRecordHistory PersonalRecordHistory[]
  fatigueLogs        FatigueLog[]

  @@index([coachId])
  @@map("athletes")
}

model TrainingWeek {
  id         String             @id @default(uuid())
  athleteId  String             @map("athlete_id")
  weekNumber Int                @map("week_number")
  startDate  DateTime           @map("start_date") @db.Date
  endDate    DateTime           @map("end_date") @db.Date
  status     TrainingWeekStatus @default(DRAFT)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  athlete Athlete       @relation(fields: [athleteId], references: [id])
  days    TrainingDay[]

  @@index([athleteId, status])
  @@map("training_weeks")
}

model TrainingDay {
  id             String   @id @default(uuid())
  trainingWeekId String   @map("training_week_id")
  weekday        Int
  scheduledDate  DateTime @map("scheduled_date") @db.Date
  title          String?
  notes          String?
  deletedAt      DateTime? @map("deleted_at")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  trainingWeek       TrainingWeek        @relation(fields: [trainingWeekId], references: [id])
  blocks             TrainingBlock[]
  workoutCompletions WorkoutCompletion[]
  feedbacks          Feedback[]
  uploadedVideos     UploadedVideo[]
  trainingMessages   TrainingMessage[]
  revisions          TrainingRevision[]

  @@index([trainingWeekId])
  @@unique([trainingWeekId, scheduledDate])
  @@index([scheduledDate, deletedAt])
  @@map("training_days")
}

model Exercise {
  id             String           @id @default(uuid())
  key            String           @unique
  trainerId      String?          @map("trainer_id")
  name           String
  category       ExerciseCategory
  prescriptionType ExercisePrescriptionType @default(LOAD) @map("prescription_type")
  prBase         PersonalRecordMovement? @map("pr_base")
  canUpdatePersonalRecord Boolean @default(false) @map("can_update_personal_record")
  isSystem       Boolean          @default(false) @map("is_system")
  isActive       Boolean          @default(true) @map("is_active")
  description    String?
  videoReference String?          @map("video_reference")
  objective      String?
  commonErrors   String?          @map("common_errors")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  trainer          User?             @relation("TrainerCustomExercises", fields: [trainerId], references: [id], onDelete: Cascade)
  complexMovements ComplexMovement[]

  @@index([trainerId, isActive])
  @@index([isSystem, isActive])
  @@map("exercises")
}

model FeedPost {
  id                   String             @id @default(uuid())
  trainerId            String             @map("trainer_id")
  authorUserId         String             @map("author_user_id")
  caption              String?
  mediaType            FeedPostMediaType? @map("media_type")
  mediaPath            String?            @map("media_path")
  mediaUrl             String?            @map("media_url")
  mediaMimeType        String?            @map("media_mime_type")
  mediaSizeBytes       Int?               @map("media_size_bytes")
  videoDurationSeconds Int?               @map("video_duration_seconds")
  deletedAt            DateTime?          @map("deleted_at")
  deletedById          String?            @map("deleted_by_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  trainer User @relation("FeedPostTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  author  User @relation("FeedPostAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  comments FeedComment[]
  likes    FeedLike[]

  @@index([trainerId, deletedAt, createdAt])
  @@index([authorUserId, createdAt])
  @@map("feed_posts")
}

model FeedComment {
  id           String    @id @default(uuid())
  postId       String    @map("post_id")
  authorUserId String    @map("author_user_id")
  text         String
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User     @relation("FeedCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([postId, deletedAt, createdAt])
  @@index([authorUserId, createdAt])
  @@map("feed_comments")
}

model FeedLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation("FeedLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@map("feed_likes")
}

model TrainingBlock {
  id            String            @id @default(uuid())
  trainingDayId String            @map("training_day_id")
  title         String
  type          TrainingBlockType
  sectionType   TrainingSectionType @map("section_type")
  notes         String?
  displayOrder  Int               @map("display_order")
  completedAt   DateTime?         @map("completed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  trainingDay      TrainingDay       @relation(fields: [trainingDayId], references: [id])
  sets             TrainingSet[]
  complexMovements ComplexMovement[]

  @@index([trainingDayId])
  @@map("training_blocks")
}

model TrainingSet {
  id                       String            @id @default(uuid())
  trainingBlockId          String            @map("training_block_id")
  exerciseKey              String?           @map("exercise_key")
  exerciseName             String            @map("exercise_name")
  exerciseCategorySnapshot ExerciseCategory? @map("exercise_category_snapshot")
  prescriptionTypeSnapshot ExercisePrescriptionType? @map("prescription_type_snapshot")
  prBaseSnapshot           PersonalRecordMovement? @map("pr_base_snapshot")
  sets                     Int
  reps                     Int
  percentage               Decimal?          @db.Decimal(5, 2)
  percentageEnd            Decimal?          @map("percentage_end") @db.Decimal(5, 2)
  prescribedWeight         Decimal?          @map("prescribed_weight") @db.Decimal(6, 2)
  targetPrExercise         TargetPrExercise? @map("target_pr_exercise")
  calculatedWeightSnapshot Decimal?          @map("calculated_weight_snapshot") @db.Decimal(6, 2)
  calculatedWeightEndSnapshot Decimal?       @map("calculated_weight_end_snapshot") @db.Decimal(6, 2)
  durationMinutes          Int?              @map("duration_minutes")
  prUpdateEligible         Boolean           @default(false) @map("pr_update_eligible")
  prCandidateDeclinedWeight Decimal?         @map("pr_candidate_declined_weight") @db.Decimal(6, 2)
  restSeconds              Int?              @map("rest_seconds")
  notes                    String?
  displayOrder             Int               @map("display_order")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  trainingBlock TrainingBlock         @relation(fields: [trainingBlockId], references: [id])
  attempts      TrainingSetAttempt[]

  @@index([trainingBlockId])
  @@map("training_sets")
}

model TrainingSetAttempt {
  id            String   @id @default(uuid())
  trainingSetId String   @map("training_set_id")
  setIndex      Int      @map("set_index")
  successful    Boolean
  completedAt   DateTime @default(now()) @map("completed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  trainingSet TrainingSet @relation(fields: [trainingSetId], references: [id])

  @@unique([trainingSetId, setIndex])
  @@index([trainingSetId])
  @@map("training_set_attempts")
}

model ComplexMovement {
  id              String   @id @default(uuid())
  trainingBlockId String   @map("training_block_id")
  exerciseId      String   @map("exercise_id")
  reps            Int
  displayOrder    Int      @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  trainingBlock TrainingBlock @relation(fields: [trainingBlockId], references: [id])
  exercise      Exercise      @relation(fields: [exerciseId], references: [id])

  @@index([trainingBlockId])
  @@map("complex_movements")
}

model WorkoutCompletion {
  id              String    @id @default(uuid())
  athleteId       String    @map("athlete_id")
  trainingDayId   String    @map("training_day_id")
  completed       Boolean   @default(false)
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  durationMinutes Int?      @map("duration_minutes")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  athlete     Athlete     @relation(fields: [athleteId], references: [id])
  trainingDay TrainingDay @relation(fields: [trainingDayId], references: [id])

  @@unique([athleteId, trainingDayId])
  @@map("workout_completions")
}

model Feedback {
  id            String   @id @default(uuid())
  athleteId     String   @map("athlete_id")
  trainingDayId String   @map("training_day_id")
  rpe           Int
  fatigue       Int
  energy        Int?
  technique     Int?
  pain          Int?
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  athlete       Athlete        @relation(fields: [athleteId], references: [id])
  trainingDay   TrainingDay    @relation(fields: [trainingDayId], references: [id])
  coachComments CoachComment[]

  @@unique([athleteId, trainingDayId])
  @@map("feedbacks")
}

model CoachComment {
  id         String   @id @default(uuid())
  feedbackId String   @map("feedback_id")
  coachId    String   @map("coach_id")
  comment    String
  score      Int?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  feedback Feedback @relation(fields: [feedbackId], references: [id])
  coach    User     @relation(fields: [coachId], references: [id])

  @@index([feedbackId])
  @@map("coach_comments")
}

model TrainingMessage {
  id            String   @id @default(uuid())
  trainingDayId String   @map("training_day_id")
  senderUserId  String   @map("sender_user_id")
  message       String
  createdAt     DateTime @default(now()) @map("created_at")

  trainingDay TrainingDay @relation(fields: [trainingDayId], references: [id])
  sender      User        @relation(fields: [senderUserId], references: [id])

  @@index([trainingDayId, createdAt])
  @@index([senderUserId, createdAt])
  @@map("training_messages")
}

model TrainingRevision {
  id            String                 @id @default(uuid())
  trainingDayId String                 @map("training_day_id")
  changedById   String                 @map("changed_by_id")
  version       Int
  action        TrainingRevisionAction
  snapshot      Json
  createdAt     DateTime               @default(now()) @map("created_at")

  trainingDay TrainingDay @relation(fields: [trainingDayId], references: [id])
  changedBy   User        @relation("TrainingRevisionActor", fields: [changedById], references: [id])

  @@index([trainingDayId, createdAt])
  @@map("training_revisions")
}

model UploadedVideo {
  id            String   @id @default(uuid())
  athleteId     String   @map("athlete_id")
  trainingDayId String   @map("training_day_id")
  exerciseName  String   @map("exercise_name")
  storagePath   String   @map("storage_path")
  duration      Int?
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  athlete     Athlete     @relation(fields: [athleteId], references: [id])
  trainingDay TrainingDay @relation(fields: [trainingDayId], references: [id])

  @@index([athleteId, trainingDayId])
  @@map("uploaded_videos")
}

model PersonalRecord {
  id         String                 @id @default(uuid())
  athleteId  String                 @map("athlete_id")
  exercise   PersonalRecordMovement
  weight     Decimal                @db.Decimal(6, 2)
  recordDate DateTime               @map("record_date") @db.Date
  notes      String?
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  athlete Athlete @relation(fields: [athleteId], references: [id])
  history PersonalRecordHistory[]

  @@unique([athleteId, exercise])
  @@index([athleteId, exercise])
  @@map("personal_records")
}

model PersonalRecordHistory {
  id               String                 @id @default(uuid())
  personalRecordId String                 @map("personal_record_id")
  athleteId        String                 @map("athlete_id")
  exercise         PersonalRecordMovement
  weight           Decimal                @db.Decimal(6, 2)
  recordDate       DateTime               @map("record_date") @db.Date
  notes            String?
  createdAt        DateTime               @default(now()) @map("created_at")

  personalRecord PersonalRecord @relation(fields: [personalRecordId], references: [id])
  athlete        Athlete        @relation(fields: [athleteId], references: [id])

  @@index([athleteId, exercise, createdAt])
  @@map("personal_record_history")
}

model FatigueLog {
  id              String   @id @default(uuid())
  athleteId       String   @map("athlete_id")
  sleepScore      Int      @map("sleep_score")
  stressScore     Int      @map("stress_score")
  motivationScore Int      @map("motivation_score")
  muscleSoreness  Int      @map("muscle_soreness")
  jointPain       Int      @map("joint_pain")
  createdAt       DateTime @default(now()) @map("created_at")

  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@index([athleteId, createdAt])
  @@map("fatigue_logs")
}
