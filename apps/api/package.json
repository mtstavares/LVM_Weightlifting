{
  "name": "@lvm/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --coverage",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:migrate": "node scripts/prisma.mjs migrate deploy",
    "prisma:migrate:dev": "node scripts/prisma.mjs migrate dev",
    "prisma:seed": "node scripts/prisma.mjs db seed",
    "seed:test-accounts": "node scripts/seed-test-accounts.mjs",
    "seed:test-accounts:force": "node scripts/seed-test-accounts.mjs --force"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^6.4.16",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^9.9.1",
    "jest": "^29.7.0",
    "prisma": "^5.19.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "node ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  }
}
